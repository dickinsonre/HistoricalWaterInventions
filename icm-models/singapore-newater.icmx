<?xml version="1.0" encoding="UTF-8"?>
<ICMExchange version="1.0">
  <Model>
    <Name>Singapore NEWater Reclamation System</Name>
    <Description>Ultra-purified reclaimed water using microfiltration, reverse osmosis, and UV treatment</Description>
    <Civilization>Singapore</Civilization>
    <Period>2003 CE - Present</Period>
    <EngineeringNotes></EngineeringNotes>
    <CreatedBy>Robert Dickinson - Historical Water Inventions</CreatedBy>
    <Units>Metric</Units>
  </Model>
  
  <Nodes>
    <Node id="J1" type="Manhole">
      <X>1000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>12.0</GroundLevel>
      <ChamberFloor>10.0</ChamberFloor>
      <ChamberArea>3.14</ChamberArea>
    </Node>
    <Node id="J2" type="Manhole">
      <X>5000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>11.952</GroundLevel>
      <ChamberFloor>9.952</ChamberFloor>
      <ChamberArea>3.14</ChamberArea>
    </Node>
    <Node id="Out1" type="Outfall">
      <X>9000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>11.904</GroundLevel>
      <InvertLevel>9.904</InvertLevel>
      <OutfallType>Free</OutfallType>
    </Node>
  </Nodes>
  
  <Links>
    <Link id="C1" type="Conduit">
      <USNode>J1</USNode>
      <DSNode>J2</DSNode>
      <Length>48000</Length>
      <Shape>Rectangular</Shape>
      <Width>2</Width>
      <Height>1</Height>
      <Roughness type="Manning">0.01</Roughness>
      <USInvert>10.0</USInvert>
      <DSInvert>9.952</DSInvert>
    </Link>
    <Link id="C2" type="Conduit">
      <USNode>J2</USNode>
      <DSNode>Out1</DSNode>
      <Length>24000</Length>
      <Shape>Rectangular</Shape>
      <Width>2</Width>
      <Height>1</Height>
      <Roughness type="Manning">0.01</Roughness>
      <USInvert>9.952</USInvert>
      <DSInvert>9.904</DSInvert>
    </Link>
  </Links>
  
  <Inflows>
    <Inflow node="J1">
      <Type>Constant</Type>
      <FlowRate unit="m3/s">800000</FlowRate>
    </Inflow>
  </Inflows>
  
  <SimulationParameters>
    <StartDate>2024-01-01</StartDate>
    <EndDate>2024-01-02</EndDate>
