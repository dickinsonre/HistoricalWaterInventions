<?xml version="1.0" encoding="UTF-8"?>
<ICMExchange version="1.0">
  <Model>
    <Name>Machu Picchu Water Supply System</Name>
    <Description>749m canal feeding 16 cascading fountains at 2,430m elevation</Description>
    <Civilization>Inca Empire</Civilization>
    <Period>1450 CE</Period>
    <EngineeringNotes></EngineeringNotes>
    <CreatedBy>Robert Dickinson - Historical Water Inventions</CreatedBy>
    <Units>Metric</Units>
  </Model>
  
  <Nodes>
    <Node id="J1" type="Manhole">
      <X>1000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>12.0</GroundLevel>
      <ChamberFloor>10.0</ChamberFloor>
      <ChamberArea>3.14</ChamberArea>
    </Node>
    <Node id="J2" type="Manhole">
      <X>5000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>11.97753</GroundLevel>
      <ChamberFloor>9.97753</ChamberFloor>
      <ChamberArea>3.14</ChamberArea>
    </Node>
    <Node id="Out1" type="Outfall">
      <X>9000.0</X>
      <Y>5000.0</Y>
      <GroundLevel>11.95506</GroundLevel>
      <InvertLevel>9.95506</InvertLevel>
      <OutfallType>Free</OutfallType>
    </Node>
  </Nodes>
  
  <Links>
    <Link id="C1" type="Conduit">
      <USNode>J1</USNode>
      <DSNode>J2</DSNode>
      <Length>749</Length>
      <Shape>Rectangular</Shape>
      <Width>0.15</Width>
      <Height>0.16</Height>
      <Roughness type="Manning">0.015</Roughness>
      <USInvert>10.0</USInvert>
      <DSInvert>9.97753</DSInvert>
    </Link>
    <Link id="C2" type="Conduit">
      <USNode>J2</USNode>
      <DSNode>Out1</DSNode>
      <Length>374.5</Length>
      <Shape>Rectangular</Shape>
      <Width>0.15</Width>
      <Height>0.16</Height>
      <Roughness type="Manning">0.015</Roughness>
      <USInvert>9.97753</USInvert>
      <DSInvert>9.95506</DSInvert>
    </Link>
  </Links>
  
  <Inflows>
    <Inflow node="J1">
      <Type>Constant</Type>
      <FlowRate unit="m3/s">0.8</FlowRate>
    </Inflow>
  </Inflows>
  
  <SimulationParameters>
    <StartDate>2024-01-01</StartDate>
    <EndDate>2024-01-02</EndDate>
    <TimeStep>30</TimeStep>
    <RoutingMethod>DynamicWave</RoutingMethod>
  </SimulationParameters>
</ICMExchange>
